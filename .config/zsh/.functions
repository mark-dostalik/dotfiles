# ANSI colors for status messages
NC=$'\e[0m'
BOLD_GREEN=$'\e[1;32m'
BOLD_YELLOW=$'\e[1;33m'
BOLD_RED=$'\e[1;31m'

# Status messages, all on stderr so they never pollute a function's output
_msg_info() {
  echo "${BOLD_GREEN}info${NC}: $*" >&2
}

_msg_warn() {
  echo "${BOLD_YELLOW}warn${NC}: $*" >&2
}

_msg_error() {
  echo "${BOLD_RED}error${NC}: $*" >&2
}

# Change current directory when exiting Yazi
y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  command yazi "$@" --cwd-file="$tmp"
  IFS= read -r -d '' cwd < "$tmp"
  [ -n "$cwd" ] && [ "$cwd" != "$PWD" ] && builtin cd -- "$cwd"
  rm -f -- "$tmp"
}

# Resolve repo root and branch paths; sets root/project/branch/slug/dir/session
_wt_ctx() {
  local common
  branch=${1:-}
  [[ -n "$branch" ]] || {
    _msg_error "usage: ${funcstack[2]} <branch>"; return 1; }
  common=$(git rev-parse --git-common-dir 2>/dev/null) || {
    _msg_error "not in a git repo"; return 1; }
  root=$(dirname "$(realpath "$common")")
  project=${root:t}
  slug=${branch//\//_}
  dir="$root/$slug"
  session="$project/$slug"
}

# Default branch name, per origin/HEAD (gc points it at the remote's default)
_wt_default() {
  local ref
  ref=$(git -C "${1:-.}" symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null) || {
    _msg_error "no origin/HEAD; run: git remote set-head origin --auto"; return 1; }
  echo "${ref#origin/}"
}

# Create/attach a git worktree, init submodules + LFS, run uv sync
gw() {
  emulate -L zsh
  setopt local_options err_return

  local root project branch slug dir session base
  _wt_ctx "${1:-}"

  if [[ ! -d "$dir" ]]; then
    # Refresh remote refs so new branches start from the latest default branch
    git -C "$root" fetch --prune origin \
      || _msg_warn "git fetch failed, using cached refs"

    if git -C "$root" show-ref --verify --quiet "refs/heads/$branch"; then
      git -C "$root" worktree add "$dir" "$branch"
    elif git -C "$root" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
      git -C "$root" worktree add --track -b "$branch" "$dir" "origin/$branch"
    else
      base=$(_wt_default "$root")
      _msg_info "branching '$branch' off origin/$base"
      git -C "$root" worktree add --no-track -b "$branch" "$dir" "origin/$base"
    fi

    ( cd "$dir" && git lfs checkout; git submodule update --init --recursive )
    if [[ -f "$dir/pyproject.toml" ]]; then
      ( cd "$dir" && uv sync ) || _msg_warn "uv sync failed"
    fi
  fi

  if [[ -n "$TMUX" ]]; then
    tmux run-shell "sesh connect \"$dir\""
  else
    sesh connect "$dir"
  fi
}

# Remove a git worktree + its branch, tmux session, and zoxide entry (confirm if dirty)
gr() {
  emulate -L zsh
  setopt local_options err_return

  local root project branch slug dir session default reply force=""
  _wt_ctx "${1:-}"
  default=$(_wt_default "$root")

  if [[ ! -d "$dir" ]]; then
    _msg_error "no worktree at $dir"; return 1
  fi
  # Never remove the default branch's worktree
  if [[ "$branch" == "$default" ]]; then
    _msg_error "refusing to remove the default worktree ('$default')"; return 1
  fi

  # Confirm before discarding uncommitted or untracked changes
  if [[ -n "$(git -C "$dir" status --porcelain)" ]]; then
    _msg_warn "'$branch' has uncommitted or untracked changes:"
    git -C "$dir" status --short >&2
    read "reply?Delete anyway? [y/N] "
    if [[ "$reply" != [yY]* ]]; then
      _msg_info "aborted"; return 1
    fi
    force="--force"
  fi

  # If attached to the session we're about to kill, move away first
  if [[ -n "$TMUX" && "$(tmux display-message -p '#S')" == "$session" ]]; then
    tmux switch-client -t "$project/${default//\//_}" 2>/dev/null \
      || tmux switch-client -l 2>/dev/null || true
  fi

  # Tear down: worktree (dir + submodules), local branch, zoxide entry, tmux session
  git -C "$dir" submodule deinit --all --force 2>/dev/null || true
  git -C "$root" worktree remove $force "$dir" 2>/dev/null || rm -rf "$dir"
  git -C "$root" worktree prune
  git -C "$root" branch -D "$branch" >/dev/null 2>&1 \
    || _msg_warn "no local branch '$branch' to delete"
  zoxide remove "$dir" 2>/dev/null || true
  if tmux has-session -t "$session" 2>/dev/null; then
    tmux kill-session -t "$session"
  fi
}

# Clone into the bare-repo + worktree layout, then hand the default branch to gw
gc() {
  emulate -L zsh
  setopt local_options err_return

  local url name base default
  url=${1:-}
  [[ -n "$url" ]] || { _msg_error "usage: gc <ssh-url> [dir-name]"; return 1; }
  name="${2:-${${url:t}%.git}}"
  base="$HOME/work/$name"

  [[ -e "$base" ]] && { _msg_error "$base already exists"; return 1; }

  # Verify the remote is reachable before creating anything on disk
  if ! git ls-remote "$url" &>/dev/null; then
    _msg_error "cannot reach '$url' (check the URL)"
    return 1
  fi

  mkdir -p "$base"
  cd "$base"

  # init + fetch rather than 'clone --bare': a bare clone would materialize
  # every remote branch as a local head with no upstream and no worktree
  git init --quiet --bare .bare
  echo "gitdir: ./.bare" > .git
  # Relative worktree links, so git still works when synced to a different path
  git config worktree.useRelativePaths true
  git remote add origin "$url"
  git lfs install --local
  git fetch origin
  git remote set-head origin --auto >/dev/null

  # Leave the bare HEAD on the remote's default so plain 'git log' etc. work
  default=$(_wt_default)
  git symbolic-ref HEAD "refs/heads/$default"

  gw "$default"
}

# --- tab completion for gw / gr ------------------------------------------

# gw: complete any local or remote branch (remotes de-prefixed + deduped)
_gw() {
  local -a branches
  branches=(${(f)"$(git for-each-ref --format='%(refname:short)' \
    refs/heads refs/remotes 2>/dev/null | sed 's|^origin/||' | sort -u)"})
  branches=(${branches:#origin})   # drop the bare 'origin' (from origin/HEAD)
  _describe -t branches 'branch' branches
}
compdef _gw gw

# gr: complete only branches that have a worktree, minus the default branch
_gr() {
  local default
  default=$(_wt_default 2>/dev/null) || return

  local -a branches
  branches=(${(f)"$(git worktree list --porcelain 2>/dev/null \
    | sed -n 's|^branch refs/heads/||p')"})
  branches=(${branches:#$default})
  _describe -t branches 'worktree branch' branches
}
compdef _gr gr
